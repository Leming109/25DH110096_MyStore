@model _25DH110096_MyStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Xóa Danh Mục</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
<div class="form-horizontal">
    <hr />
    <div class="form-group form-actions">
        <div class="col-md-offset-2 col-md-10">
            <div class="form-group">
                <h4>Bạn Thực Sự muôn Xóa Danh mục này ?</h4>
            </div>
        </div>
        <div class="control-label col-md-2 ">Tên Danh mục</div>
        <div class="col-md-10">
            @* Hien thi gia tri cua cateName *@
            @Html.DisplayFor(model => model.CategoryName)
        </div>

        <div class="form-group form-actions">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Xóa" class="btn btn-primary" /> |
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-primary " })
            </div>

        </div>
    </div>
        </div>

        }
